portfolio_js = r'''window.PORTFOLIO = {
  name: "Akshat Dwivedi",
  role: "AI/ML ENGINEER IN PROGRESS",
  secondaryRole: "Gen AI Developer · Machine Learning Enthusiast · Problem Solver",
