html = r'''<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Akshat Dwivedi | AI/ML Engineer</title>
<meta name="description" content="Portfolio of Akshat Dwivedi — an AIML student exploring Machine Learning, Generative AI, software engineering and intelligent systems.">
<meta property="og:title" content="Akshat Dwivedi | AI/ML Engineer">
<meta property="og:description" content="A cinematic portfolio for an AIML student building toward AI/ML engineering.">
<meta name="theme-color" content="#050608">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="styles.css">
<script src="portfolio.js"></script>
</head>
<body>
<div class="noise"></div>
<div class="cursor-dot"></div><div class="cursor-ring"></div>

<header class="nav">
  <a class="brand" href="#home" aria-label="Akshat home"><span>AK</span><i>•</i></a>
  <nav class="nav-links" aria-label="Primary">
    <a href="#about">About</a><a href="#skills">Skills</a><a href="#work">Projects</a><a href="#lab">AI Lab</a><a href="#journey">Journey</a><a href="#achievements">Achievements</a><a href="#contact">Contact</a>
  </nav>
  <a class="resume" href="/resume.pdf">Resume <span>↗</span></a>
  <button class="menu" aria-label="Open menu"><span></span><span></span></button>
</header>

<div class="mobile-menu">
  <a href="#about">About</a><a href="#skills">Skills</a><a href="#work">Projects</a><a href="#lab">AI Lab</a><a href="#journey">Journey</a><a href="#achievements">Achievements</a><a href="#contact">Contact</a>
</div>

<main>
<section id="home" class="hero">
  <div class="hero-copy">
    <p class="micro">NOT A TEMPLATE <span>•</span> BUILT FOR AKSHAT</p>
    <h1><span>AKSHAT</span><span class="outline">DWIVEDI</span></h1>
    <p class="hero-sub">Building my way from AIML fundamentals<br>to intelligent systems.</p>
    <div class="hero-actions">
      <a class="pill primary" href="#work">Explore my work <span>↓</span></a>
      <a class="pill" href="#contact">Let's connect <span>↗</span></a>
    </div>
    <div class="hero-meta">
      <span>AIML / 2ND YEAR</span><span>JAVA + DSA</span><span>ML / GEN AI</span>
    </div>
  </div>

  <div class="hero-stage" aria-hidden="true">
    <div class="stage-grid"></div>
    <div class="orbital o1"></div><div class="orbital o2"></div><div class="orbital o3"></div>
    <div class="core">
      <div class="core-inner"><span>AI</span><b></b><b></b><b></b><b></b></div>
    </div>
    <div class="node n1"></div><div class="node n2"></div><div class="node n3"></div><div class="node n4"></div>
  </div>
  <div class="scroll-note"><span></span> NATIVE SCROLL DRIVES THE EXPERIENCE</div>
</section>

<section class="reference-section intro-scene" id="about">
  <div class="scene-text left"><span class="scene-index">01</span><p>WHERE CURIOSITY<br>MEETS <em>CODE.</em></p></div>
  <div class="scene-card-wrap">
    <article class="scene-card">
      <div class="card-chrome"><span>AKSHAT / ABOUT</span><span>02 / 07</span></div>
      <div class="card-body about-card">
        <div class="mini-orbit"><div class="mini-core">AK</div></div>
        <div><span class="tiny">CURRENT STATE</span><h2>Learning.<br><em>Building.</em><br>Experimenting.</h2><p>2nd-year Artificial Intelligence & Machine Learning student.</p></div>
      </div>
    </article>
  </div>
  <div class="portrait-orbit"><div class="avatar"><span>AK</span></div><small>AKSHAT</small></div>
</section>

<section class="content-section" id="about-detail">
  <div class="section-head"><span>01 / ABOUT ME</span><h2>THE BUILD<br><em>BEGINS HERE.</em></h2></div>
  <div class="two-col">
    <div class="copy-block"><p id="bio1"></p><p id="bio2"></p></div>
    <div class="truth-card"><span>POSITIONING</span><strong>AI/ML<br>ENGINEER<br><i>IN PROGRESS</i></strong><small>Not a professional claim — a direction I'm actively building toward.</small></div>
  </div>
</section>

<section class="reference-section statement-scene">
  <div class="scene-text center"><span class="scene-index">02</span><p>A CUSTOM SKILLSET<br>CREATES <em>THIS.</em></p></div>
  <div class="scene-card-wrap">
    <article class="scene-card tilted">
      <div class="card-chrome"><span>SKILL MATRIX</span><span>03 / 07</span></div>
      <div class="skill-preview">
        <div class="skill-bar"><span>PYTHON</span><i style="width:72%"></i><b>LEARNING</b></div>
        <div class="skill-bar"><span>JAVA</span><i style="width:56%"></i><b>DEVELOPING</b></div>
        <div class="skill-bar"><span>DSA</span><i style="width:48%"></i><b>DEVELOPING</b></div>
        <div class="skill-bar"><span>ML / GEN AI</span><i style="width:36%"></i><b>EXPLORING</b></div>
      </div>
    </article>
  </div>
</section>

<section class="content-section" id="skills">
  <div class="section-head"><span>02 / SKILLS</span><h2>WHAT I'M<br><em>BUILDING.</em></h2></div>
  <div class="skill-grid" id="skillGrid"></div>
</section>

<section class="reference-section work-scene" id="work">
  <div class="scene-text right"><span class="scene-index">03</span><p>THE WORK<br>IS THE <em>PROOF.</em></p></div>
  <div class="scene-card-wrap">
    <article class="scene-card project-preview">
      <div class="card-chrome"><span>PROJECT SYSTEM</span><span>04 / 07</span></div>
      <div class="preview-content"><div class="preview-window"><div class="window-top"></div><div class="fake-lines"></div><div class="fake-lines short"></div><div class="fake-chart"></div></div><div class="preview-label"><span>REAL PROJECTS ONLY</span><b>NO FAKE METRICS</b></div></div>
    </article>
  </div>
</section>

<section class="content-section" id="projects-detail">
  <div class="section-head"><span>03 / FEATURED PROJECTS</span><h2>BUILD.<br><em>DON'T PRETEND.</em></h2></div>
  <div class="empty-projects" id="projectGrid">
    <div class="empty-project"><span>PROJECT DATABASE</span><strong>ADD YOUR REAL PROJECTS</strong><p>The UI is ready. Add only projects you have actually built inside <code>portfolio.js</code>.</p></div>
  </div>
</section>

<section class="reference-section lab-scene" id="lab">
  <div class="scene-text left"><span class="scene-index">04</span><p>GENERATED AT<br><em>RUNTIME.</em></p></div>
  <div class="scene-card-wrap">
    <article class="scene-card">
      <div class="card-chrome"><span>AI LAB / QUERY</span><span>05 / 07</span></div>
      <div class="chat-preview"><div class="bubble user">What is Akshat learning?</div><div class="bubble bot">Java + DSA, Machine Learning and Generative AI — with projects as the destination.</div><div class="chat-cursor"></div></div>
    </article>
  </div>
</section>

<section class="content-section ai-lab-section">
  <div class="section-head"><span>04 / AI LAB</span><h2>ASK MY<br><em>PORTFOLIO.</em></h2></div>
  <div class="lab">
    <div class="lab-window">
      <div class="lab-top"><span>AKSHAT.AI</span><span>FRONTEND DEMO · NO API KEY</span></div>
      <div class="messages" id="messages"><div class="msg bot">Ask me about Akshat's learning path, skills, projects or career goal.</div></div>
      <div class="suggestions" id="suggestions"></div>
      <form id="labForm"><input id="labInput" autocomplete="off" placeholder="Ask something about Akshat…"><button>↗</button></form>
    </div>
    <div class="lab-note"><span>ARCHITECTURE</span><strong>Portfolio data → retrieval layer → LLM/API later</strong><p>This demo is intentionally frontend-only. Connect your own backend/LLM later; never expose provider API keys in browser code.</p></div>
  </div>
</section>

<section class="reference-section journey-scene" id="journey">
  <div class="scene-text center"><span class="scene-index">05</span><p>NATIVE SCROLL<br><em>DRIVES IT.</em></p></div>
  <div class="scene-card-wrap">
    <article class="scene-card">
      <div class="card-chrome"><span>JOURNEY / TIMELINE</span><span>06 / 07</span></div>
      <div class="timeline-preview"><span class="active"></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
      <div class="timeline-label"><b>2ND YEAR AIML</b><small>CURRENT</small></div>
    </article>
  </div>
</section>

<section class="content-section" id="journey-detail">
  <div class="section-head"><span>05 / JOURNEY</span><h2>FROM NOW<br>TO <em>THE GOAL.</em></h2></div>
  <div class="journey" id="journeyList"></div>
</section>

<section class="content-section" id="achievements">
  <div class="section-head"><span>06 / ACHIEVEMENTS</span><h2>NUMBERS<br>ONLY WHEN <em>REAL.</em></h2></div>
  <div class="achievement-grid" id="achievementGrid"></div>
</section>

<section class="reference-section final-scene">
  <div class="scene-text center"><span class="scene-index">06</span><p>WANT THE<br><em>BUILD?</em></p></div>
  <div class="scene-card-wrap">
    <article class="scene-card final-card">
      <div class="card-chrome"><span>CONTACT / AKSHAT</span><span>07 / 07</span></div>
      <div class="final-preview"><span>BUILDING TOWARD</span><strong>AI/ML<br>ENGINEERING</strong><a href="#contact">CONNECT ↗</a></div>
    </article>
  </div>
  <div class="portrait-orbit final-avatar"><div class="avatar"><span>AK</span></div><small>LET'S BUILD</small></div>
</section>

<section class="content-section contact-section" id="contact">
  <div class="contact-inner">
    <span class="eyebrow">07 / CONTACT</span>
    <h2>LET'S BUILD<br><em>SOMETHING.</em></h2>
    <p>I'm currently learning, building and looking for opportunities to grow through real-world projects and internships.</p>
    <div class="contact-actions">
      <a class="contact-btn disabled" id="emailBtn">Email me <span>↗</span></a>
      <a class="contact-btn disabled" id="githubBtn">GitHub <span>↗</span></a>
      <a class="contact-btn disabled" id="linkedinBtn">LinkedIn <span>↗</span></a>
