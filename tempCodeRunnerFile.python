  ],

  achievements: [
    {label: "LeetCode", value: "ADD YOUR REAL NUMBER", meta: "Problems solved"},
    {label: "GitHub", value: "ADD YOUR REAL NUMBER", meta: "Public repositories"},
    {label: "Certifications", value: "ADD YOUR REAL NUMBER", meta: "Verified certificates"},
    {label: "Hackathons", value: "ADD YOUR REAL NUMBER", meta: "Participations / wins"}
  ],

  journey: [
    {phase: "PAST", title: "School", copy: "Foundation years and the beginning of the interest in technology."},
    {phase: "PAST", title: "College", copy: "Started the Artificial Intelligence & Machine Learning degree path."},
    {phase: "CURRENT", title: "2nd Year AIML", copy: "Strengthening programming, problem solving and AI/ML foundations."},
    {phase: "LEARNING", title: "Java + DSA", copy: "Building consistency through a structured Java and DSA course."},
    {phase: "LEARNING", title: "Machine Learning", copy: "Moving from fundamentals toward practical ML systems."},
